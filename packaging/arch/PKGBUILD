pkgname=github-enhanced
pkgver=0.2.6
pkgrel=1
pkgdesc='Customizable native Git desktop client'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'git')
makedepends=('cmake' 'ninja')
optdepends=('github-cli: GitHub account and preference sync')
source=("github-enhanced-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/github-enhanced-$pkgver" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=ON
    cmake --build "$srcdir/build"
}
check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}
package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
    install -Dm644 "$srcdir/github-enhanced-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
